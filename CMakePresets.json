{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (MSVC, newest installed Visual Studio)",
      "inherits": "base",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64 (MSVC, newest installed Visual Studio)",
      "inherits": "base",
      "architecture": "ARM64",
      "cacheVariables": { "MDV_BUILD_TESTS": "OFF" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows (MinGW-w64 GCC, Ninja)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux",
      "displayName": "Linux (native: x86_64 or aarch64)",
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-arm64-cross",
      "displayName": "Linux aarch64 (cross-compile from x86_64)",
      "inherits": "base",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "cacheVariables": { "MDV_BUILD_TESTS": "OFF", "GLFW_BUILD_WAYLAND": "OFF" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS universal (arm64 + x86_64)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "web",
      "displayName": "Web (Emscripten / WebAssembly)",
      "inherits": "base",
      "generator": "Ninja",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    }
  ],
  "buildPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "windows-arm64", "configurePreset": "windows-arm64", "configuration": "Release" },
    { "name": "windows-mingw", "configurePreset": "windows-mingw" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "linux-arm64-cross", "configurePreset": "linux-arm64-cross" },
    { "name": "macos-universal", "configurePreset": "macos-universal" },
    { "name": "web", "configurePreset": "web" }
  ],
  "testPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "windows-mingw", "configurePreset": "windows-mingw" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "macos-universal", "configurePreset": "macos-universal" }
  ]
}
